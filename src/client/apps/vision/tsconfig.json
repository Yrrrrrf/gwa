{
	"extends": ["$app/tsconfig", "../../config/tsconfig.json"],
	"compilerOptions": {
		"paths": {
			"@sdk": ["../../sdk/mod.ts"],
			"@sdk/*": ["../../sdk/*/src/mod.ts"],
			"#lib": ["./src/lib/mod.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src/**/*",
		".svelte-kit/ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"vite.config.mts"
	]
}
