{
	"extends": "../../config/tsconfig.json",
	"compilerOptions": {
		"paths": {
			"@sdk": ["../../sdk/mod.ts"],
			"@sdk/*": ["../../sdk/*/src/mod.ts"],
			"#lib": ["./src/lib/mod.ts"],
			"#lib/*": ["./src/lib/*"],
			"@sdk/ui": ["../../sdk/ui/types/vue.d.ts"]
		},
		"types": ["vite/client"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.vue",
		"src/**/*.d.ts",
		"vite.config.mts"
	]
}
