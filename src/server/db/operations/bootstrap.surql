DEFINE NAMESPACE IF NOT EXISTS __NS_IDENT__;
USE NS __NS_IDENT__;
DEFINE DATABASE IF NOT EXISTS __DB_IDENT__;
USE DB __DB_IDENT__;
DEFINE TABLE IF NOT EXISTS migration SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON migration TYPE string;
DEFINE FIELD IF NOT EXISTS checksum ON migration TYPE string;
DEFINE FIELD IF NOT EXISTS applied_at ON migration TYPE datetime;
DEFINE INDEX IF NOT EXISTS migration_version ON migration FIELDS version UNIQUE;
DEFINE TABLE IF NOT EXISTS migration_lock SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS owner ON migration_lock TYPE string;
DEFINE FIELD IF NOT EXISTS acquired_at ON migration_lock TYPE datetime;
